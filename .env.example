# ---------------------------------------------------------------------------
# Bault environment template (T007).
# Copy to `.env` and fill REAL values by hand. `.env` is git-ignored.
# Secrets live here, never in code (Constitution Principle IX: secrets outside code).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
API_PORT=3000

# Where the Vite dev server forwards /api/* (development only — production builds
# call /api/v1 on their own origin and are routed by the reverse proxy).
# Leave unset to use http://127.0.0.1:<API_PORT>. Set it when the API runs
# elsewhere, e.g. in a container: VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# Use 127.0.0.1 rather than localhost: localhost resolves to both ::1 and
# 127.0.0.1, and a refused connection then surfaces as an opaque AggregateError.
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# PostgreSQL (single source of truth). PgBouncer listens on 6432, Postgres on 5432.
# Point the API at PgBouncer (6432); point drizzle-kit migrations at Postgres (5432).
DATABASE_URL=postgres://bault:bault@localhost:6432/bault
DIRECT_DATABASE_URL=postgres://bault:bault@localhost:5432/bault

# Session cookies (ACC). Long random string; rotate to invalidate all sessions.
SESSION_COOKIE_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=session

# Object storage (S3-compatible; MinIO locally, Hetzner in prod). Item images.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=eu-central
STORAGE_BUCKET=bault-images
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Payment provider (tokenizing, e.g. Stripe). Sandbox keys only in dev.
PAYMENT_PROVIDER=stripe
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Shipping provider (ShipStation / Easyship). Sandbox keys only in dev.
SHIPPING_PROVIDER=shipstation
SHIPPING_API_KEY=

# ---------------------------------------------------------------------------
# Transactional email (account verification + password reset).
#
# EMAIL_PROVIDER selects the adapter:
#   console  Development sink. The message, INCLUDING the verification/reset
#            link, is printed to the API's stdout and nothing is sent. Fine for
#            local work — but note that activating an account or recovering a
#            password then means reading the link out of the server log.
#   smtp     Real delivery. The four SMTP_* values below become REQUIRED and the
#            API refuses to boot without them.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_API_KEY=

# --- SMTP, set up with a Gmail app password ---------------------------------
# Gmail rejects your normal account password over SMTP. An "app password" is a
# separate 16-character credential you generate per application:
#
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#      (app passwords are not offered until it is on)
#   2. Create one at https://myaccount.google.com/apppasswords
#   3. Google shows it as four groups of four, e.g. "abcd efgh ijkl mnop".
#      Paste it below WITH OR WITHOUT the spaces — both are accepted.
#   4. SMTP_USER is the full Gmail address; SMTP_FROM should use that same
#      address, or Gmail rewrites the sender.
#
# The app password is a credential: it belongs in `.env` (git-ignored), never
# in this template and never in code. Revoke it from the same page if leaked.
#
# Port 587 with SMTP_SECURE=false is STARTTLS and is the usual choice. Port 465
# with SMTP_SECURE=true is implicit TLS; both are encrypted.
#
# Any other SMTP server works identically — Postmark, SES, Mailgun, Fastmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Bault <you@gmail.com>

# Public origin of the web app. Used to build the absolute links inside those
# emails; the SPA is a hash router, so a link reads <APP_BASE_URL>/#/verify-email
# ?token=… . Origin only — no path, no trailing slash. In production this is the
# customer-facing hostname, NOT the API's.
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Wallet debt policy (PAY).
#
# A negative balance already blocks spending actions immediately. These three
# control what happens after that:
#   GRACE_DAYS     how long a debt may sit before interest starts accruing
#   INTEREST_BPS   daily interest on a debt past the grace period, in basis
#                  points (5 = 0.05%/day); 0 disables accrual entirely
#   SUSPEND_BELOW  balance, in MINOR UNITS and negative, below which the daily
#                  sweep suspends the account until the debt clears
#                  (-2000 = -$20.00)
#
# A suspended holder cannot sign in, and so cannot cash in to clear their own
# debt — reinstatement happens automatically once the balance recovers, which in
# practice means an administrator crediting them or one of their listings selling.
# ---------------------------------------------------------------------------
WALLET_DEBT_GRACE_DAYS=14
WALLET_DEBT_INTEREST_BPS=5
WALLET_SUSPEND_BELOW_MINOR=-2000

# ---------------------------------------------------------------------------
# WHERE COLLECTORS SEND MONEY
#
# All OPTIONAL. A route with nothing configured is shown to the customer as
# unavailable rather than as a placeholder somebody might wire money to.
#
# These are bank particulars: they belong in the deployment environment and
# never in version control.
# ---------------------------------------------------------------------------
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ROUTING_NUMBER=
BANK_IBAN=
BANK_SWIFT=
BANK_ADDRESS=
PAYPAL_FF_HANDLE=

# ---------------------------------------------------------------------------
# PUBLISHED SUPPORT DETAILS
#
# All four are OPTIONAL, and the app is honest about an empty one: a channel
# with no value configured is shown as "not published", never as a placeholder
# somebody might dial or write to. The in-app helpdesk works regardless — it is
# the route that does not depend on any of this being filled in.
#
# SUPPORT_TEAM names the people who answer, as `Name|Role`, separated by `;`.
# ---------------------------------------------------------------------------
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=
SUPPORT_TEAM=

# Observability (T022 wires these up).
SENTRY_DSN=
LOG_LEVEL=info
