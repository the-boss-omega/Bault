{
  "name": "@bault/api",
  "version": "0.1.0",
  "private": true,
  "description": "Bault modular-monolith API (NestJS). Single transactional boundary.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm --filter @bault/config build && pnpm --filter @bault/adapters build && nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@bault/adapters": "workspace:*",
    "@bault/config": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/node": "10.75.3",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^12.0.10",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
