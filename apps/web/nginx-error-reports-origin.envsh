#!/bin/sh

ERROR_REPORTS_ORIGIN=
if [ -n "${WEB_SENTRY_DSN:-}" ]; then
  ERROR_REPORTS_ORIGIN=$(printf '%s' "$WEB_SENTRY_DSN" | sed -E 's|^([A-Za-z][A-Za-z0-9+.-]*://)([^@/?#]*@)?([^/?#]*).*$|\1\3|')
  if ! printf '%s' "$ERROR_REPORTS_ORIGIN" | grep -Eq '^https://([A-Za-z0-9-]+\.)*[A-Za-z0-9-]+(:[0-9]{1,5})?$'; then
    echo "nginx-error-reports-origin: the web image was built with a VITE_SENTRY_DSN that is not of the form https://<key>@host/<project>; refusing to start" >&2
    exit 1
  fi
fi

export ERROR_REPORTS_ORIGIN
