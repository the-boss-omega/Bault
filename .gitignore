# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env & secrets — NEVER commit real secrets (Constitution Principle IX)
.env
.env.*
!.env.example
# The server's template is committed; the filled-in file beside it never is.
# `.env.*` above matches at every level, and `!.env.example` only un-ignores a
# file with that exact name — so the server template needs its own exception,
# and `infra/.env.server` stays ignored by the line above.
!infra/.env.server.example

# Logs & coverage
*.log
coverage/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local data volumes
/data/
# Playwright CLI output (may contain credentials)
.playwright-cli/

# Local files that must never be published: `assets/` is the web app
# publicDir, so anything left in it ships in the bundle and is downloadable
# from any deployed URL.
_local/
