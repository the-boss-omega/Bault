# =============================================================================
# /etc/bault/api.env — the API's database connection, as bault_app.
#
# Read after production.env by the `api` service only. bault_app reads and
# writes rows and cannot alter the schema, drop a trigger or UPDATE/DELETE a
# history table (infra/production/roles.sql). Mode 600, owner deploy.
#
# DATABASE_URL may go through a pooler (PgBouncer, transaction mode);
# DIRECT_DATABASE_URL must be a direct session. TLS as described in
# production.env.example.
# =============================================================================
DATABASE_URL=postgres://bault_app:CHANGE_ME@db-pooler.example.internal:6432/bault?sslmode=verify-full&sslrootcert=/etc/bault/db-ca.crt
DIRECT_DATABASE_URL=postgres://bault_app:CHANGE_ME@db.example.internal:5432/bault?sslmode=verify-full&sslrootcert=/etc/bault/db-ca.crt
