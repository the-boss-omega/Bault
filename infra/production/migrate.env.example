# =============================================================================
# /etc/bault/migrate.env — the schema owner's connection, as bault_owner.
#
# Read after production.env by the `migrate` service, and by deploy.sh for the
# backup dump and for re-running infra/production/roles.sql after every
# migration. Never given to the api or worker. Mode 600, owner deploy.
#
# Direct connections, never a pooler: DDL and pg_dump need a real session.
# TLS as described in production.env.example; with verify-full and sslrootcert
# psql and pg_dump on the host verify the server exactly as the containers do.
# =============================================================================
DATABASE_URL=postgres://bault_owner:CHANGE_ME@db.example.internal:5432/bault?sslmode=verify-full&sslrootcert=/etc/bault/db-ca.crt
DIRECT_DATABASE_URL=postgres://bault_owner:CHANGE_ME@db.example.internal:5432/bault?sslmode=verify-full&sslrootcert=/etc/bault/db-ca.crt
