# =============================================================================
# /etc/bault/production.env — everything a production Bault needs, except
# the database connections, which are per service (see "Database" below), and
# the nightly backup's settings (/etc/bault/backup.env, infra/ops/crontab.example).
#
# Copy to /etc/bault/production.env (mode 600, owner deploy; the directory is
# 700) and replace every value. Nothing below is real, and nothing real belongs
# in this repository.
#
# Read twice:
#   - by docker compose as `--env-file`, to fill compose.yml (BAULT_DOMAIN,
#     BAULT_REGISTRY, STORAGE_ENDPOINT…);
#   - by the api, worker and migrate containers as their environment, where
#     packages/config/src/env.ts validates it. With NODE_ENV=production that
#     schema REFUSES to boot on a sandbox payment, storage, shipping or email
#     provider, on TRUST_PROXY=loopback, on a non-https APP_BASE_URL, on an
#     open API explorer without a password, on a missing or development
#     MFA_ENCRYPTION_KEY, and on MFA_REQUIRED_ROLES without both staff roles.
#     A refusal names every problem at once; `docker compose logs api` shows it.
#
# Format: KEY=value, one per line, no `export`. Quote a value with single
# quotes if it contains `$` (compose would otherwise interpolate it) or `#`.
# =============================================================================

NODE_ENV=production

# -----------------------------------------------------------------------------
# Where the site lives
# -----------------------------------------------------------------------------
# The public hostname. Caddy obtains its certificate for exactly this name, so
# its DNS A/AAAA records must point at this server before the first deploy.
BAULT_DOMAIN=app.example.com
# The same host as a URL: links in verification and reset emails are built from
# it. Must be https:// (production refuses anything else). No trailing slash.
APP_BASE_URL=https://app.example.com
# Where the images are pulled from: <registry>/bault-{api,worker,web}:<tag>.
BAULT_REGISTRY=ghcr.io/OWNER
# Extra compose files, relative to the checkout, space-separated, that deploy.sh
# adds after compose.yml. On Google Cloud: infra/gcp/compose.gcp.yml, which adds
# the Cloud SQL Auth Proxy (infra/gcp/README.md). Empty everywhere else.
BAULT_COMPOSE_EXTRA=
# A service deploy.sh starts before it backs up the database, and waits for
# until the owner's URL answers: the database connector, when there is one.
# On Google Cloud: cloudsql. Empty everywhere else.
BAULT_DB_SIDECAR=
# On Google Cloud only: the Cloud SQL instance the proxy connects to, as
# <project>:<region>:<instance> (infra/gcp/provision.sh prints it).
# CLOUDSQL_INSTANCE=

# -----------------------------------------------------------------------------
# The proxy chain
# -----------------------------------------------------------------------------
# Which hops may report the client's address (Express `trust proxy`): the
# docker network in compose.yml, where Caddy and nginx live. Must equal that
# network's subnet. `loopback` (the development default) is refused: nginx is
# another container, not loopback, so every visitor would be one address to the
# rate limiter and the sign-in log. Never `true`.
TRUST_PROXY=172.30.89.0/24
# Same origin for the SPA and the API, so no cross-origin browser access.
CORS_ORIGINS=
# Empty when the server faces the internet directly. Behind Cloudflare's proxy:
# Cloudflare's ranges, space-separated (see the Caddyfile for where to get them
# and why). Caddy then trusts CF-Connecting-IP from those addresses only.
BAULT_TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# The connection strings are NOT in this file. api, worker and migrate each
# connect as their own role (infra/production/roles.sql), so each has its own
# file in /etc/bault holding only DATABASE_URL and DIRECT_DATABASE_URL, read
# after this one (see compose.yml):
#
#   api.env      bault_app     reads and writes rows; cannot change the schema,
#                              drop a trigger or rewrite history
#   worker.env   bault_worker  the same, plus ownership of pg-boss's schema
#   migrate.env  bault_owner   runs migrations, roles.sql and the backup dump
#
# Templates: api.env.example, worker.env.example, migrate.env.example.
#
# TLS. Every URL ends in
#   ?sslmode=verify-full&sslrootcert=/etc/bault/db-ca.crt
# and /etc/bault/db-ca.crt is the provider's CA certificate (mode 644; it is
# public). node-postgres treats sslmode=require as verify-full and checks the
# chain against Node's own CA list, which does not contain a managed provider's
# private CA, so without sslrootcert every connection is refused. compose.yml
# mounts the file read-only into api, worker and migrate at the same path, and
# pg_dump on the host (the backup) reads it there too. If the provider's
# certificate is publicly trusted, put the system bundle there instead:
#   cp /etc/ssl/certs/ca-certificates.crt /etc/bault/db-ca.crt
#
# Connections per process.
DATABASE_POOL_MAX=10
# The statement timeout is not set here. roles.sql sets it on bault_app and
# bault_worker (30s), and Postgres applies it at every login: an API that sent
# it itself would be refused by a PgBouncer pooler ("unsupported startup
# parameter"). DATABASE_STATEMENT_TIMEOUT_MS is no longer read.

# -----------------------------------------------------------------------------
# Two-factor sign-in
# -----------------------------------------------------------------------------
# The key TOTP secrets are encrypted under (AES-256-GCM). Required; the API
# refuses to boot without it, or with the development key. Generate it once:
#   openssl rand -base64 32
# and keep a copy with the other secrets: losing or changing it makes every
# enrolled authenticator unreadable, and each account then has to be reset by
# an administrator and enrol again.
MFA_ENCRYPTION_KEY=CHANGE_ME
# Who must use a second factor. Unset means admin,warehouse_operator, which is
# also the least production accepts: a list without both staff roles is
# refused. Add `user` to require it of collectors too.
# MFA_REQUIRED_ROLES=admin,warehouse_operator

# -----------------------------------------------------------------------------
# Payments: PayPal
# -----------------------------------------------------------------------------
# `sandbox` is refused in production. PAYPAL_ENVIRONMENT=sandbox with sandbox
# credentials runs the real integration with fake money (staging); `live` for
# real money. Register a webhook at https://<BAULT_DOMAIN>/api/v1/webhooks/payment
# and paste its id: without it webhooks cannot be verified and the API refuses
# to start.
PAYMENT_PROVIDER=paypal
PAYPAL_ENVIRONMENT=live
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
PAYPAL_WEBHOOK_ID=CHANGE_ME
PAYPAL_PAYOUT_NOTE=Your Bault cash-out

# How cash-outs leave: `provider` sends them through the PayPal Payouts API;
# `manual` queues them for a person to pay and record.
PAYOUT_MODE=manual

# -----------------------------------------------------------------------------
# Shipping: EasyPost
# -----------------------------------------------------------------------------
# `sandbox` is refused in production. EZTK… is EasyPost's test mode (real code
# path, no real labels, no money): right for staging. EZAK… is live.
SHIPPING_PROVIDER=easypost
EASYPOST_API_KEY=CHANGE_ME
# EASYPOST_BASE_URL is for test harnesses only. Leave it out.

# -----------------------------------------------------------------------------
# Email: SMTP
# -----------------------------------------------------------------------------
# `console` is refused in production (it prints reset links to the log).
# Port 587 with SMTP_SECURE=false is STARTTLS; 465 with true is implicit TLS.
# Either way TLS is required: a server that does not offer STARTTLS is refused
# before the password is sent. SMTP_REQUIRE_TLS=false is refused here.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Bault <noreply@example.com>

# -----------------------------------------------------------------------------
# Object storage: S3-compatible bucket for item photographs and videos
# -----------------------------------------------------------------------------
# `sandbox` is refused in production (it discards every photograph). The
# bucket stays private; browsers get five-minute presigned URLs.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_REGION=CHANGE_ME
STORAGE_BUCKET=bault-images
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
# The origin browsers load those URLs from, for the CSP's img-src and media-src.
# Leave empty to use STORAGE_ENDPOINT's origin, which is right for the
# path-style URLs the API signs. Set it only if photographs are served from
# elsewhere (a CDN). scheme://host[:port], nothing more.
STORAGE_PUBLIC_ORIGIN=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# API surface
# -----------------------------------------------------------------------------
# Requests per minute per client address: the whole API, and the sign-in /
# registration / reset routes. Correct only if TRUST_PROXY is.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=30
# The OpenAPI explorer at /docs is a complete route map. Off. If it is ever
# turned on, API_DOCS_PASSWORD is required.
EXPOSE_API_DOCS=false
API_DOCS_PASSWORD=

# -----------------------------------------------------------------------------
# Wallet debt policy (business decisions; these are the defaults)
# -----------------------------------------------------------------------------
WALLET_DEBT_GRACE_DAYS=14
WALLET_DEBT_INTEREST_BPS=5
WALLET_SUSPEND_BELOW_MINOR=-2000

# -----------------------------------------------------------------------------
# Published details. All optional; an empty one is shown as "not published",
# never as a placeholder somebody might pay or dial.
# -----------------------------------------------------------------------------
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ROUTING_NUMBER=
BANK_IBAN=
BANK_SWIFT=
BANK_ADDRESS=
PAYPAL_FF_HANDLE=
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=
# Name|Role pairs separated by `;`
SUPPORT_TEAM=

# -----------------------------------------------------------------------------
# Never set in production
# -----------------------------------------------------------------------------
# ALLOW_DESTRUCTIVE_SEED  lets the seed TRUNCATE a NODE_ENV=production database.
#                         The image does not even contain the seed.
# CADDY_LOCAL_CERTS, BAULT_HTTP_PORT, BAULT_HTTPS_PORT
#                         local rehearsal only (see README.md).
