# =============================================================================
# /etc/bault/worker.env — the worker's database connection, as bault_worker.
#
# Read after production.env by the `worker` service only. bault_worker has the
# API's rights on the application tables and owns pg-boss's `pgboss` schema
# (infra/production/roles.sql). Mode 600, owner deploy.
#
# Both URLs point at the server, never a pooler: the worker and pg-boss use
# DIRECT_DATABASE_URL, and the schema requires DATABASE_URL to be set as well.
# TLS as described in production.env.example.
# =============================================================================
DATABASE_URL=postgres://bault_worker:CHANGE_ME@db.example.internal:5432/bault?sslmode=verify-full&sslrootcert=/etc/bault/db-ca.crt
DIRECT_DATABASE_URL=postgres://bault_worker:CHANGE_ME@db.example.internal:5432/bault?sslmode=verify-full&sslrootcert=/etc/bault/db-ca.crt
