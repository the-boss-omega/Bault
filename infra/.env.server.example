# =============================================================================
# The server's environment. Copy to `infra/.env.server` and fill in.
#
#   cp infra/.env.server.example infra/.env.server
#
# `.env.server` is gitignored and must stay that way: it holds the database
# password, the cookie secret and the two passwords that are the only thing
# between the internet and this deployment.
#
# This file is written for DEMO MODE — the sandbox adapters, no external
# accounts, nothing to sign up for. The "Switching to production" section at the
# bottom says exactly what changes when that stops being true.
# =============================================================================

# ---------------------------------------------------------------------------
# Where it lives. Both names need an A record pointing at this host.
# ---------------------------------------------------------------------------
APP_DOMAIN=bault.example.com
CODE_DOMAIN=code.example.com
# Let's Encrypt sends expiry warnings here. A real address you read.
ACME_EMAIL=you@example.com

# Absolute path to the checkout on the host, mounted into the editor so what you
# edit is what deploys. Set it to wherever you cloned the repo.
REPO_PATH=/opt/bault

# ---------------------------------------------------------------------------
# The two passwords.
#
# BASIC_AUTH_HASH is a bcrypt hash, not the password. Generate it with:
#
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your password'
#
# It prints something like  $2a$14$Xk9.../3mQ
#
# DOUBLE EVERY `$` WHEN YOU PASTE IT HERE.  Compose treats `$x` in this file as a
# variable reference and replaces it with nothing, so an unescaped hash arrives
# at Caddy mangled and every login fails with no useful error. The line above
# becomes:
#
#   BASIC_AUTH_HASH=$$2a$$14$$Xk9.../3mQ
#
# (Verified: `$$` here reaches the container as a single `$`. `deploy.sh` refuses
# to run if it finds an unescaped one.)
# ---------------------------------------------------------------------------
BASIC_AUTH_USER=bault
BASIC_AUTH_HASH=REPLACE_WITH_BCRYPT_HASH

# The editor's own password, asked for after Caddy's. Make it long; it guards a
# terminal on this machine.
CODE_SERVER_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD

# ---------------------------------------------------------------------------
# The database. Never published to the host; only this compose network reaches it.
# ---------------------------------------------------------------------------
POSTGRES_USER=bault
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD
POSTGRES_DB=bault

# ---------------------------------------------------------------------------
# Demo mode.
#
# `development` is what lets the sandbox adapters run at all: with
# NODE_ENV=production the API refuses to boot on storage that discards
# photographs, mail that goes to a log file, shipping that cannot buy a label or
# payments that settle without contacting anybody (packages/config/src/env.ts).
# That refusal is correct. This is the acknowledgement, not a workaround.
# ---------------------------------------------------------------------------
APP_NODE_ENV=development

# Caddy and nginx both sit in front, on a private bridge network. `uniquelocal`
# trusts those hops for the client's address and nothing else. NEVER `true`.
TRUST_PROXY=uniquelocal

# ---------------------------------------------------------------------------
# Adapters. All sandbox in demo mode — see the switch list at the bottom.
#
# STORAGE_PROVIDER=sandbox ACCEPTS UPLOADS AND DISCARDS THEM. What this costs on
# a demo: the catalogue photographs on the register, the display case and the
# marketplace come from the web image's own /images/ folder and are unaffected —
# the product looks completely right. What breaks is an item's MEDIA GALLERY
# (intake and photography scans), which will be empty, and anything uploaded
# during the demo, which does not come back. That is the trade for having no
# object store to run, back up or keep alive while you are away.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=sandbox
SHIPPING_PROVIDER=sandbox
EMAIL_PROVIDER=console
PAYMENT_PROVIDER=sandbox

# The five STORAGE_* values are required by the schema WHATEVER the provider is
# (packages/config/src/env.ts:80-84) — the sandbox never reads them, but the
# config refuses to parse without them and the API will not start. Placeholders
# are fine in demo mode; STORAGE_ENDPOINT has to be a syntactically valid URL.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=bault
STORAGE_ACCESS_KEY=unused-in-sandbox
STORAGE_SECRET_KEY=unused-in-sandbox

# Keys the HMAC on media URLs. Any long random string; changing it invalidates
# every media link already issued. Generate one with:
#   openssl rand -base64 32
SESSION_COOKIE_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
SESSION_COOKIE_NAME=bault_session

# ---------------------------------------------------------------------------
# Limits.
#
# The development .env sets AUTH_RATE_LIMIT_PER_MINUTE=5000, which behind a
# public URL means 5000 password attempts a minute against accounts that share
# one password. Ten is plenty for a demo and for you.
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_MINUTE=300

# The OpenAPI explorer hands a reader the whole route map. Off.
EXPOSE_API_DOCS=false

LOG_LEVEL=info

# =============================================================================
# Switching to production later
#
# When there are real accounts to point at, change these five and redeploy. The
# env schema refuses to boot if any of them is still a sandbox, so a half-done
# switch fails loudly at start rather than quietly in front of a customer.
#
#   APP_NODE_ENV=production
#   STORAGE_PROVIDER=s3          + STORAGE_ENDPOINT / _REGION / _BUCKET /
#                                  _ACCESS_KEY / _SECRET_KEY
#                                  (an endpoint the BROWSER can reach — a
#                                  loopback one is served through the API
#                                  instead, anything else is used directly and
#                                  must be added to the CSP's img-src)
#   SHIPPING_PROVIDER=easypost   + EASYPOST_API_KEY (an EZTK… test key is free
#                                  and production-safe)
#   EMAIL_PROVIDER=smtp          + EMAIL_API_KEY
#   PAYMENT_PROVIDER=paypal      + PAYPAL_ENVIRONMENT=sandbox, PAYPAL_CLIENT_ID,
#                                  PAYPAL_CLIENT_SECRET, PAYPAL_WEBHOOK_ID
#
# Two things that are NOT env and will still be true: the worker's tracking job
# hard-codes the sandbox shipping adapter, so parcels never reach `delivered`
# (DIVE1 §13.9, B2); and the seeded accounts share one password, so a production
# database must never be seeded.
# =============================================================================
