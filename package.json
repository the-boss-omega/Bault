{
  "name": "bault",
  "version": "0.1.0",
  "private": true,
  "description": "Bault — collectibles vaulting & marketplace platform (modular monolith monorepo)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @bault/api dev",
    "dev:worker": "pnpm --filter @bault/worker dev",
    "dev:web": "pnpm --filter @bault/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "users:remove-test": "node scripts/remove-test-users.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --project web && vitest run --project contract && vitest run --no-file-parallelism --project integration && vitest run --no-file-parallelism --project concurrency && vitest run --no-file-parallelism --project property",
    "test:seeded": "pnpm --filter @bault/api db:migrate && pnpm --filter @bault/api db:seed && pnpm test",
    "test:all-parallel": "vitest run",
    "test:web": "vitest run --project web",
    "test:integration": "vitest run --no-file-parallelism --project integration",
    "test:concurrency": "vitest run --no-file-parallelism --project concurrency",
    "test:property": "vitest run --no-file-parallelism --project property",
    "test:contract": "vitest run --project contract"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
